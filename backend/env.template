# Configuration du serveur
PORT=3000
NODE_ENV=development

# Configuration MongoDB
# Pour développement local (MongoDB en Docker sur localhost):
MONGODB_URI=mongodb://localhost:27017/chronicle
# Pour Docker Compose complet (backend dans Docker):
# MONGODB_URI=mongodb://mongodb:27017/chronicle

# Alternative SQLite (pour déploiement léger)
# USE_SQLITE=true
# SQLITE_PATH=./data/chronicle.db

# Configuration n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/chronicle

# CORS
CORS_ORIGIN=http://localhost:5173


